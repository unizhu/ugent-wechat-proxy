# =============================================================================
# UGENT WeChat Proxy Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For production deployment at /opt/ugent-wechat-proxy/.env
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: WeChat Official Account (公众号)
# -----------------------------------------------------------------------------

# WeChat token for signature verification (set in WeChat MP platform)
WECHAT_TOKEN=your_wechat_token_here

# API key for authenticating UGENT WebSocket clients (generate a secure random string)
PROXY_API_KEY=your_secure_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: WeChat Encryption & API (Security Mode)
# -----------------------------------------------------------------------------

# 43-character EncodingAESKey from WeChat MP platform
# Required only if using encrypted message mode
# WECHAT_ENCODING_AES_KEY=

# WeChat AppID (required for decryption and API calls)
# WECHAT_APP_ID=

# WeChat AppSecret (required for async reply via Customer Service API)
# WECHAT_APP_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL: WeChat Template Messages (for delayed notifications)
# -----------------------------------------------------------------------------

# Template ID for "Response Ready" notification
# Get from WeChat MP > Template Messages
# WECHAT_TEMPLATE_RESPONSE_READY=

# -----------------------------------------------------------------------------
# OPTIONAL: WeCom (企业微信) Configuration
# Set WECOM_ENABLED to enable the WeCom webhook listener on WECOM_WEBHOOK_ADDR
# -----------------------------------------------------------------------------

# Enable WeCom support (set to any value to enable, e.g. "true")
# WECOM_ENABLED=true

# WeCom token for signature verification (set in WeCom admin console)
# WECOM_TOKEN=

# 43-character EncodingAESKey from WeCom admin console
# WECOM_ENCODING_AES_KEY=

# WeCom CorpID (Enterprise ID)
# WECOM_CORP_ID=

# WeCom AgentID (Application ID, numeric)
# WECOM_AGENT_ID=

# WeCom CorpSecret (for general API calls like sending messages)
# WECOM_CORP_SECRET=

# WeCom KF Secret (for Customer Service API sync_msg — separate from CorpSecret)
# WECOM_KF_SECRET=

# WeCom webhook callback route path
# WECOM_CALLBACK_PATH=/wecom/callback

# WeCom webhook server bind address
# WECOM_WEBHOOK_ADDR=0.0.0.0:8082

# -----------------------------------------------------------------------------
# OPTIONAL: Server Configuration
# -----------------------------------------------------------------------------

# WeChat OA webhook route path
# WECHAT_WEBHOOK_PATH=/wechat/webhook

# Webhook server bind address (receives from WeChat OA)
# WEBHOOK_ADDR=0.0.0.0:8080

# WebSocket server bind address (UGENT connects here)
# WEBSOCKET_ADDR=0.0.0.0:8081

# -----------------------------------------------------------------------------
# OPTIONAL: Client Management
# -----------------------------------------------------------------------------

# Allowed client IDs (comma-separated, empty = allow all)
# ALLOWED_CLIENTS=ugent-main,ugent-backup

# Maximum WebSocket connections per client
# MAX_CONNECTIONS_PER_CLIENT=10

# -----------------------------------------------------------------------------
# OPTIONAL: Timing & Limits
# -----------------------------------------------------------------------------

# Message timeout in seconds (WeChat requires response within 5s)
# MESSAGE_TIMEOUT_SECS=5

# Rate limit: max messages per minute per client
# RATE_LIMIT=100

# -----------------------------------------------------------------------------
# OPTIONAL: Message Storage
# Enable to persist messages to SQLite for history and debugging
# -----------------------------------------------------------------------------

# Enable message storage (set to any value to enable, e.g. "true")
# STORAGE_ENABLED=true

# SQLite database path
# STORAGE_PATH=~/.ugent/database/wecom_cache.db

# Message retention in days (0 = keep forever)
# MESSAGE_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# OPTIONAL: Media Cache
# Downloaded images, voice files, etc. from WeChat/WeCom media API
# -----------------------------------------------------------------------------

# Media cache directory
# MEDIA_CACHE_DIR=/tmp/ugent-media-cache

# -----------------------------------------------------------------------------
# OPTIONAL: Debugging
# -----------------------------------------------------------------------------

# Enable debug mode (log raw messages, set to any value to enable)
# DEBUG_MODE=false

# Rust log level (used by docker-compose)
# RUST_LOG=info,ugent_wechat_proxy=debug
